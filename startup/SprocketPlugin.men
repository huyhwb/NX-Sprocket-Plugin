!
! NX Sprocket Plugin Menu
!
VERSION 120
EDIT UG_GATEWAY_MAIN_MENUBAR

BEFORE UG_HELP
    CASCADE_BUTTON SPROCKET_PLUGIN_MENU
    LABEL Sprocket Tool(&S)
END_OF_BEFORE

MENU SPROCKET_PLUGIN_MENU
    BUTTON SPROCKET_GENERATE
    LABEL Generate Sprocket...
    BITMAP sprocket_icon.bmp
    ACTIONS SprocketPlugin.vb
END_OF_MENU
